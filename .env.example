# Project Configuration
PROJECT_NAME="Doc2Action API"
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Security & JWT
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Vector Store / RAG Configuration
VECTOR_STORE_PROVIDER=memory
EMBEDDING_MODEL=text-embedding-004
VECTOR_DIMENSION=768

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc2action
# Optional explicit database URL (overrides individual POSTGRES_* settings if set)
# DATABASE_URL=postgresql://user:password@localhost:5432/doc2action

# CORS Origins (comma-separated list or JSON array string)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

